variables = {
	"aws_region": {
		"name":  "aws_region",
		"value": "us-east-1",
	},
}

raw = {
	"configuration": {
		"provider_config": {
			"aws": {
				"name":      "aws",
				"full_name": "registry.terraform.io/hashicorp/aws",
				"expressions": {
					"region": {
						"references": ["var.aws_region"],
					},
				},
			},
		},
	},
}